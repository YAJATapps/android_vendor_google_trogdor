// Prebuilt Mesa3D libraries for Freedreno / Turnip (Adreno 618) on Qualcomm SC7180

cc_prebuilt_library_shared {
    name: "libgallium_dri",
    vendor: true,
    compile_multilib: "64",
    srcs: ["libgallium_dri.so"],
    shared_libs: [
        "libdrm",
        "liblog",
        "libcutils",
        "libnativewindow",
        "libsync",
        "libz",
    ],
    check_elf_files: false,
    prefer: true,
    strip: {
        none: true,
    },
}

// ────────────────────────────────────────────────────────────────
// GBM — Generic Buffer Management
// Installs as /vendor/lib64/libgbm_mesa.so
// No stem property = zero Kati/Make output collision with minigbm/libgbm
// ────────────────────────────────────────────────────────────────
cc_prebuilt_library_shared {
    name: "libgbm_mesa",
    vendor: true,
    compile_multilib: "64",
    srcs: ["libgbm_mesa.so"],
    shared_libs: [
        "libdrm",
        "liblog",
    ],
    check_elf_files: false,
    prefer: true,
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "dri_gbm",
    vendor: true,
    compile_multilib: "64",
    srcs: ["dri_gbm.so"],
    shared_libs: [
        "libgallium_dri",
        "libdrm",
        "liblog",
    ],
    check_elf_files: false,
    prefer: true,
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "libEGL_mesa",
    stem: "libEGL_mesa",
    vendor: true,
    compile_multilib: "64",
    relative_install_path: "egl",
    srcs: ["libEGL.so"],
    shared_libs: [
        "libgallium_dri",
        "libgbm_mesa",
        "libdrm",
        "liblog",
        "libcutils",
        "libnativewindow",
        "libsync",
    ],
    check_elf_files: false,
    prefer: true,
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "libGLESv1_CM_mesa",
    stem: "libGLESv1_CM_mesa",
    vendor: true,
    compile_multilib: "64",
    relative_install_path: "egl",
    srcs: ["libGLESv1_CM.so"],
    shared_libs: [
        "libEGL_mesa",
        "libgallium_dri",
        "liblog",
    ],
    check_elf_files: false,
    prefer: true,
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "libGLESv2_mesa",
    stem: "libGLESv2_mesa",
    vendor: true,
    compile_multilib: "64",
    relative_install_path: "egl",
    srcs: ["libGLESv2.so"],
    shared_libs: [
        "libEGL_mesa",
        "libgallium_dri",
        "liblog",
    ],
    check_elf_files: false,
    prefer: true,
    strip: {
        none: true,
    },
}

// ────────────────────────────────────────────────────────────────
// Vulkan — Turnip Freedreno HAL Driver
// Installs as /vendor/lib64/hw/vulkan.freedreno.so
// ────────────────────────────────────────────────────────────────
cc_prebuilt_library_shared {
    name: "vulkan.freedreno",
    stem: "vulkan.freedreno",
    vendor: true,
    compile_multilib: "64",
    relative_install_path: "hw",
    srcs: ["vulkan.freedreno.so"],
    shared_libs: [
        "libdrm",
        "liblog",
        "libcutils",
        "libnativewindow",
        "libsync",
        "libz",
    ],
    check_elf_files: false,
    prefer: true,
    strip: {
        none: true,
    },
}
